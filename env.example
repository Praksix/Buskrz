# ===========================================
# CONFIGURATION DE LA BASE DE DONNÉES
# ===========================================

# Type de base de données (postgresql, mysql, h2, etc.)
DB_TYPE=postgresql

# Configuration de la base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buskrz_db
DB_USERNAME=buskrz_user
DB_PASSWORD=your_secure_password_here

# URL de connexion complète (optionnel, sera construite automatiquement si non fournie)
# DATABASE_URL=postgresql://buskrz_user:your_secure_password_here@localhost:5432/buskrz_db

# Configuration du pool de connexions
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30000

# ===========================================
# CONFIGURATION DE L'API BACKEND
# ===========================================

# Port du serveur backend
SERVER_PORT=8080

# Contexte de l'application
SERVER_CONTEXT_PATH=/api

# Configuration CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# ===========================================
# CONFIGURATION JWT / SÉCURITÉ
# ===========================================

# Clé secrète pour JWT (générez une clé forte en production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRATION_TIME=86400000
JWT_REFRESH_EXPIRATION_TIME=604800000

# Configuration de sécurité
BCRYPT_ROUNDS=12

# ===========================================
# CONFIGURATION FRONTEND (REACT/VITE)
# ===========================================

# URL de l'API backend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=10000

# Configuration de l'environnement
VITE_APP_NAME=Buskrz
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Application de covoiturage

# ===========================================
# CONFIGURATION EMAIL (optionnel)
# ===========================================

# Configuration SMTP pour l'envoi d'emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@buskrz.com

# ===========================================
# CONFIGURATION FICHIERS/UPLOADS
# ===========================================

# Dossier de stockage des fichiers uploadés
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ===========================================
# CONFIGURATION LOGGING
# ===========================================

# Niveau de log (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# ===========================================
# CONFIGURATION CACHE (optionnel)
# ===========================================

# Configuration Redis (if utilisé)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===========================================
# CONFIGURATION EXTERNE (APIs tierces)
# ===========================================

# Configuration pour les services externes
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# ===========================================
# CONFIGURATION DÉVELOPPEMENT
# ===========================================

# Mode de développement
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Configuration pour le hot reload
VITE_HMR_PORT=5173

# ===========================================
# CONFIGURATION PRODUCTION
# ===========================================

# Variables spécifiques à la production (à décommenter en prod)
# NODE_ENV=production
# SPRING_PROFILES_ACTIVE=prod
# DB_SSL=true
# DB_SSL_MODE=require
